{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zamzam Foods",
  "version": "1.0.3",
  "identifier": "com.zamzamfoods.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zamzam Foods — Enterprise Distribution Management",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "copyright": "Copyright © 2026 Zamzam Foods",
    "shortDescription": "Zamzam Foods — Enterprise Distribution Management",
    "longDescription": "Zamzam Foods wholesale distribution, delivery route dispatch, billing, and automatic local database backups.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "headerImage": "icons/128x128.png",
        "installerIcon": "icons/icon.ico",
        "installMode": "both"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "dmg": {}
    }
  }
}
